# Quantum-Resistant Blockchain Security Toolkit - Environment Configuration
# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Blockchain anchoring (optional) -----------------------------------------
# Without BLOCKCHAIN_PRIVATE_KEY the API still runs; only the /api/blockchain/*
# routes return 503.
BLOCKCHAIN_PRIVATE_KEY=your_funded_testnet_private_key

# Defaults target Ethereum Sepolia. Override to use another network.
WEB3_RPC_URL=https://sepolia.gateway.tenderly.co
CONTRACT_ADDRESS=0x9F7946197AD3693e79948a229AAf177fAC3644Bf
CHAIN_ID=11155111

# --- API security -------------------------------------------------------------
# When set, /api/blockchain/store and /test-blockchain require the header
# X-API-Key with this value. Leave unset for local development.
# Set it in any public deployment: /api/blockchain/store spends gas.
TOOLKIT_API_KEY=

# Comma-separated list of allowed browser origins. "*" permits any origin and
# disables credentialed CORS. Set explicit origins in production.
ALLOWED_ORIGINS=*

# --- Server -------------------------------------------------------------------
# PORT is read on startup; most PaaS providers inject it automatically.
PORT=8000
